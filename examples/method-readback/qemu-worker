#!/usr/bin/env python3
"""Select the fixed instruction clock and optionally append the Core boot module."""
import os
import sys

args = sys.argv[1:]
module = os.environ.get("PCPOS_CORE_MODULE")
if module:
    # QEMU separates boot modules with commas, and module arguments by spaces.
    if any(char in module for char in ", \t\r\n"):
        sys.exit("Core module path cannot contain commas or whitespace")
    index = args.index("-initrd") + 1
    args[index] += "," + module
qemu = os.environ["PCPOS_REAL_QEMU"]
os.execv(qemu, [qemu, "-icount", "shift=3,align=off,sleep=off", *args])

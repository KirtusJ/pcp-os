--- a/PCP_OS_Rust/crates/pcpos-kernel/linker.ld
+++ b/PCP_OS_Rust/crates/pcpos-kernel/linker.ld
@@ -1,9 +1,9 @@
-/* The kernel is loaded at 1 MiB and runs there. Sections are page-aligned so that each can be mapped with
+/* The kernel is loaded at 32 MiB and runs there. Sections are page-aligned so that each can be mapped with
    exactly the permissions it needs: code is never writable, data is never executable. */
 ENTRY(_start)
 SECTIONS
 {
-  . = 1M;
+  . = 32M;
   .boot : { KEEP(*(.multiboot)) *(.boot.text) *(.boot.data) }
   .text : ALIGN(4K) { __text_start = .; *(.text .text.*) . = ALIGN(4K); __text_end = .; }
   .rodata : ALIGN(4K) { __rodata_start = .; *(.rodata .rodata.*) . = ALIGN(4K); __rodata_end = .; }
--- a/PCP_OS_Rust/crates/pcpos-kernel/src/arch.rs
+++ b/PCP_OS_Rust/crates/pcpos-kernel/src/arch.rs
@@ -533,7 +533,7 @@
 /// Where the image begins: the loader places it at one mebibyte (linker.ld). The firmware experiment
 /// links it elsewhere by changing this and the linker script, and nothing else: no other line may
 /// assume the figure.
-pub const IMAGE_START: usize = 1 << 20;
+pub const IMAGE_START: usize = 32 << 20;
 /// Where a loader that gives only a size counts its upper memory from: one mebibyte, by the Multiboot
 /// specification (3.3, `mem_upper`), wherever the image itself is linked (A3).
 const UPPER_MEMORY_FROM: usize = 1 << 20;

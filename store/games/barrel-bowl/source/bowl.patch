diff --git a/doomgeneric/bowl_card.c b/doomgeneric/bowl_card.c
new file mode 100644
index 0000000..cf50b78
--- /dev/null
+++ b/doomgeneric/bowl_card.c
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// An illuminated score sheet for the completed ten-frame game.
+#include <stdio.h>
+#include "bowl.h"
+#include "bowl_card.h"
+#include "v_video.h"
+
+enum {
+    SHADOW = 7, CABINET = 5, CELL = 109, BRONZE = 141, AMBER = 248,
+    PAPER = 49, GREEN = 114, RUBY = 175, MUTED = 144
+};
+
+static const unsigned char letters[26][7] = {
+    {14,17,17,31,17,17,17},{30,17,17,30,17,17,30},
+    {14,17,16,16,16,17,14},{30,17,17,17,17,17,30},
+    {31,16,16,30,16,16,31},{31,16,16,30,16,16,16},
+    {14,17,16,23,17,17,14},{17,17,17,31,17,17,17},
+    {14,4,4,4,4,4,14},{7,2,2,2,2,18,12},
+    {17,18,20,24,20,18,17},{16,16,16,16,16,16,31},
+    {17,27,21,21,17,17,17},{17,25,25,21,19,19,17},
+    {14,17,17,17,17,17,14},{30,17,17,30,16,16,16},
+    {14,17,17,17,21,18,13},{30,17,17,30,20,18,17},
+    {15,16,16,14,1,1,30},{31,4,4,4,4,4,4},
+    {17,17,17,17,17,17,14},{17,17,17,17,17,10,4},
+    {17,17,17,17,21,27,17},{17,17,10,4,10,17,17},
+    {17,17,10,4,4,4,4},{31,1,2,4,8,16,31}
+};
+static const unsigned char digits[10][7] = {
+    {14,17,19,21,25,17,14},{4,12,4,4,4,4,14},
+    {14,17,1,2,4,8,31},{30,1,1,14,1,1,30},
+    {2,6,10,18,31,2,2},{31,16,16,30,1,1,30},
+    {14,16,16,30,17,17,14},{31,1,2,4,8,8,8},
+    {14,17,17,14,17,17,14},{14,17,17,15,1,1,14}
+};
+
+static void glyph(int x, int y, int c, int ink, int scale)
+{
+    static const unsigned char slash[7] = {1,1,2,4,8,16,16};
+    static const unsigned char dash[7] = {0,0,0,14,0,0,0};
+    static const unsigned char bang[7] = {4,4,4,4,4,0,4};
+    const unsigned char *rows;
+    int i, j;
+    if (c >= 'A' && c <= 'Z') rows = letters[c-'A'];
+    else if (c >= '0' && c <= '9') rows = digits[c-'0'];
+    else if (c == '/') rows = slash;
+    else if (c == '-') rows = dash;
+    else if (c == '!') rows = bang;
+    else return;
+    for (i=0; i<7; ++i)
+        for (j=0; j<5; ++j)
+            if (rows[i] & (16 >> j))
+                V_DrawFilledBox(x+j*scale,y+i*scale,scale,scale,ink);
+}
+
+static void text_at(int x, int y, const char *s, int ink, int scale)
+{
+    for (; *s; ++s, x+=6*scale) glyph(x,y,*s,ink,scale);
+}
+
+// The console uses the original status-bar space at normal screen sizes.
+static void console_base(void)
+{
+    V_DrawFilledBox(0,168,320,32,CABINET);
+    V_DrawFilledBox(0,168,320,1,AMBER);
+    V_DrawFilledBox(0,199,320,1,BRONZE);
+}
+
+static void readout(int x, int width, const char *name, const char *value, int color)
+{
+    V_DrawFilledBox(x,172,width,23,SHADOW);
+    text_at(x+4,174,name,MUTED,1);
+    text_at(x+4,185,value,color,1);
+}
+
+void Bowl_DrawConsole(int frame, int ball, int score, int standing, const char *result)
+{
+    char value[16];
+    int row, col, pin = 0;
+    console_base();
+    snprintf(value,sizeof(value),"%d/10",frame);
+    readout(4,38,"FRAME",value,PAPER);
+    snprintf(value,sizeof(value),"%d",ball);
+    readout(44,31,"BALL",value,PAPER);
+    snprintf(value,sizeof(value),"%03d",score);
+    readout(77,44,"SCORE",value,GREEN);
+    readout(123,106,"PINSETTER",result,AMBER);
+    snprintf(value,sizeof(value),"%d",standing);
+    readout(231,52,"STANDING",value,PAPER);
+    V_DrawFilledBox(285,172,31,23,SHADOW);
+    for (row=0;row<4;++row)
+        for (col=0;col<=row;++col,++pin)
+            V_DrawFilledBox(299+(2*col-row)*4,190-row*5,3,3,
+                            Bowl_Standing(pin) ? GREEN : CELL);
+}
+
+static void frame_box(int f, int x, int y)
+{
+    char number[12];
+    int i, mark, start = x+23, score = Bowl_FrameScore(f);
+    V_DrawFilledBox(x,y,54,31,CELL);
+    V_DrawFilledBox(x,y,54,1,BRONZE);
+    V_DrawFilledBox(x,y,17,13,CABINET);
+    snprintf(number,sizeof(number),"%d",f+1);
+    text_at(x+2,y+3,number,MUTED,1);
+    for (i=0;i<(f==9 ? 3 : 2);++i)
+    {
+        mark = Bowl_Mark(f,i);
+        glyph(start+i*10,y+3,mark,(mark=='X'||mark=='/') ? GREEN : PAPER,1);
+    }
+    V_DrawFilledBox(x+2,y+13,50,1,BRONZE);
+    if (score >= 0)
+    {
+        snprintf(number,sizeof(number),"%d",score);
+        text_at(x+4,y+19,number,PAPER,1);
+    }
+}
+
+void Bowl_DrawCard(void)
+{
+    int i, total;
+    char final[8];
+    if (!Bowl_Active() || !Bowl_GameOver()) return;
+    total = Bowl_FrameScore(9);
+    console_base();
+    text_at(12,181,"PHOBOS LANES",MUTED,1);
+    text_at(185,181,"LEAGUE SCORE SHEET",MUTED,1);
+    V_DrawFilledBox(14,13,294,143,SHADOW);
+    V_DrawFilledBox(11,10,294,143,BRONZE);
+    V_DrawFilledBox(12,11,292,141,CABINET);
+    V_DrawFilledBox(12,11,292,2,AMBER);
+    // The final score in the right window is large enough to read from the lane.
+    text_at(22,20,"PHOBOS LANES",MUTED,1);
+    text_at(21,32,"BARREL BOWL",PAPER,2);
+    text_at(218,19,"FINAL SCORE",AMBER,1);
+    snprintf(final,sizeof(final),"%03d",total >= 0 && total <= 300 ? total : 0);
+    text_at(227,32,final,GREEN,2);
+    V_DrawFilledBox(21,52,274,1,BRONZE);
+    for (i=0;i<10;++i)
+        frame_box(i,21+(i%5)*55,59+(i/5)*33);
+    V_DrawFilledBox(21,127,274,1,BRONZE);
+    text_at(22,135,total==300 ? "PERFECT GAME" : "GAME COMPLETE",AMBER,1);
+    text_at(204,135,"FIRE TO REPLAY",PAPER,1);
+}

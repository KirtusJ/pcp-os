diff --git a/doomgeneric/bowl.c b/doomgeneric/bowl.c
new file mode 100644
index 0000000..81bf52c
--- /dev/null
+++ b/doomgeneric/bowl.c
@@ -0,0 +1,370 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Barrel bowling on the E1M9 arcade lane. Positions and speeds below are
+// measured in Doom map units and units/tic; mobj coordinates use 16.16.
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include "bowl.h"
+#include "bowl_card.h"
+#include "omega.h"
+#include "doomstat.h"
+#include "p_local.h"
+#include "m_argv.h"
+#include "i_system.h"
+#include "sounds.h"
+#include "s_sound.h"
+#include "w_wad.h"
+#include "v_video.h"
+
+
+
+enum { PIN_COUNT = 10, TENTH = 9, SUBSTEPS = 4 };
+static int enabled;
+static struct {
+    int frame, standing, count[10], rolls[10][3];
+} card;
+
+typedef struct {
+    double x, y, vx, vy;
+    mobj_t *actor;
+    int down;
+} body_t;
+static body_t pins[PIN_COUNT], ball;
+static int settling, shot_time, attack_held, gutter, rack_pending;
+static char result[40];
+
+int Bowl_Active(void)
+{
+    return enabled && gameepisode == 1 && gamemap == 9 && gamemission == doom;
+}
+
+int Bowl_Rolling(void) { return settling; }
+double Bowl_BallY(void) { return ball.actor ? ball.y : -10000.0; }
+int Bowl_Standing(int pin) { return pin >= 0 && pin < PIN_COUNT && !pins[pin].down; }
+
+int Bowl_GameOver(void) { return card.frame == 10; }
+
+int Bowl_Mark(int frame, int b)
+{
+    int n;
+    if (frame < 0 || frame > TENTH || b < 0 || b >= card.count[frame]) return ' ';
+    n = card.rolls[frame][b];
+    if (b == 1 && card.rolls[frame][0] != 10 && card.rolls[frame][0]+n == 10) return '/';
+    if (b == 2 && card.rolls[frame][0] == 10 && card.rolls[frame][1] != 10 &&
+        card.rolls[frame][1]+n == 10) return '/';
+    return n == 10 ? 'X' : n == 0 ? '-' : '0'+n;
+}
+
+int Bowl_FrameScore(int frame)
+{
+    int rolls[21], used = 0, index = 0, total = 0, f, b;
+    if (frame < 0 || frame > TENTH) return -1;
+    for (f = 0; f <= TENTH; ++f)
+        for (b = 0; b < card.count[f]; ++b)
+            rolls[used++] = card.rolls[f][b];
+    for (f = 0; f <= frame; ++f)
+    {
+        int n = card.count[f];
+        int needed;
+        if (f == TENTH)
+        {
+            if (!Bowl_GameOver()) return -1;
+            for (b = 0; b < n; ++b) total += rolls[index+b];
+            return total;
+        }
+        if (!n || (n == 1 && rolls[index] != 10)) return -1;
+        needed = (rolls[index] == 10 || rolls[index]+rolls[index+1] == 10) ? 3 : 2;
+        if (index + needed > used) return -1;
+        for (b = 0; b < needed; ++b) total += rolls[index+b];
+        index += n;
+    }
+    return total;
+}
+
+// Input is pinfall on this delivery. The saved standing count distinguishes
+// a fill ball against a part rack from a new rack on the tenth.
+static void record_roll(int hits)
+{
+    int f = card.frame, b, first;
+    if (f > TENTH || hits < 0 || hits > card.standing) return;
+    b = card.count[f]++;
+    card.rolls[f][b] = hits;
+    first = card.rolls[f][0];
+    card.standing -= hits;
+    if (f < TENTH)
+    {
+        if (first == 10 || b == 1) ++card.frame;
+    }
+    else if (b == 2 || (b == 1 && first < 10 && card.standing > 0))
+        ++card.frame;
+    rack_pending = !Bowl_GameOver() && (card.frame != f || !card.standing);
+    if (rack_pending) card.standing = 10;
+}
+
+static void respot(void)
+{
+    int row, col, i = 0;
+    for (row = 0; row < 4; ++row)
+        for (col = 0; col <= row; ++col, ++i)
+        {
+            body_t *p = &pins[i];
+            if (p->actor) P_RemoveMobj(p->actor);
+            memset(p, 0, sizeof(*p));
+            p->x = (2*col-row)*24;
+            p->y = 384+row*42;
+            p->actor = P_SpawnMobj((fixed_t)(p->x*FRACUNIT),(fixed_t)(p->y*FRACUNIT),
+                                  ONFLOORZ,MT_BOWL_PIN);
+        }
+    rack_pending = 0;
+}
+
+static void new_game(void)
+{
+    memset(&card, 0, sizeof(card));
+    card.standing = 10;
+    settling = 0;
+    respot();
+    strcpy(result,"FIRE TO ROLL");
+    printf("BOWL: fresh 10-frame card and ten pins\n");
+}
+
+void Bowl_LevelStart(void)
+{
+    // P_SetupLevel has freed all actors belonging to the preceding level.
+    memset(pins,0,sizeof(pins));
+    memset(&ball,0,sizeof(ball));
+    attack_held = 0;
+    if (Bowl_Active()) new_game();
+}
+
+static void move_actor(body_t *b)
+{
+    mobj_t *m = b->actor;
+    P_UnsetThingPosition(m);
+    m->x = (fixed_t)(b->x*FRACUNIT);
+    m->y = (fixed_t)(b->y*FRACUNIT);
+    P_SetThingPosition(m);
+    m->floorz = m->subsector->sector->floorheight;
+    m->ceilingz = m->subsector->sector->ceilingheight;
+    m->z = m->floorz;
+}
+
+static void throw_ball(player_t *player)
+{
+    mobj_t *m = player->mo;
+    unsigned int a = m->angle >> ANGLETOFINESHIFT;
+    double dx = (double)finecosine[a]/FRACUNIT;
+    double dy = (double)finesine[a]/FRACUNIT;
+    if (dy < 0.25)
+    {
+        strcpy(result,"FACE THE PINS");
+        return;
+    }
+    ball.x = (double)m->x/FRACUNIT + 24*dx;
+    ball.y = (double)m->y/FRACUNIT + 24*dy;
+    ball.vx = 21*dx;
+    ball.vy = 21*dy;
+    ball.actor = P_SpawnMobj((fixed_t)(ball.x*FRACUNIT),(fixed_t)(ball.y*FRACUNIT),
+                             ONFLOORZ,MT_BOWL_BALL);
+    settling = 1;
+    shot_time = gutter = 0;
+    strcpy(result,"ROLLING");
+    S_StartSound(m,sfx_brroll);
+}
+
+void Bowl_Input(player_t *p)
+{
+    int attack = (p->cmd.buttons & BT_ATTACK) != 0;
+    if (attack && !attack_held && !settling && p == &players[consoleplayer])
+    {
+        if (Bowl_GameOver()) new_game();
+        else throw_ball(p);
+    }
+    attack_held = attack;
+    // Hide the gun and consume its trigger without playing a shooting state.
+    p->psprites[ps_weapon].state = p->psprites[ps_flash].state = NULL;
+    p->cmd.buttons &= ~BT_ATTACK;
+}
+
+static void topple(body_t *p)
+{
+    if (!p->down)
+    {
+        p->down = 1;
+        P_SetMobjState(p->actor,S_BOWL_PIN_FALL);
+        S_StartSound(p->actor,sfx_brpins);
+    }
+}
+
+// Collide two disks along their line of centers. The ball weighs four pins.
+// A hit pin stays in the simulation and can drive the next row of the rack.
+static void collide(body_t *a, body_t *b, double dist, int is_ball)
+{
+    double dx = b->x-a->x, dy = b->y-a->y, d2 = dx*dx+dy*dy;
+    double d, closing, impulse, inva = is_ball ? 0.25 : 1.0;
+    if (d2 >= dist*dist || d2 < 0.0001) return;
+    d = sqrt(d2);
+    dx /= d;
+    dy /= d;
+    closing = (a->vx-b->vx)*dx + (a->vy-b->vy)*dy;
+    if (closing < 0.65) return;
+    impulse = 1.8*closing/(inva+1.0);
+    a->vx -= impulse*inva*dx;
+    a->vy -= impulse*inva*dy;
+    b->vx += impulse*dx;
+    b->vy += impulse*dy;
+    topple(b);
+}
+
+static void travel_ball(void)
+{
+    ball.x += ball.vx/SUBSTEPS;
+    ball.y += ball.vy/SUBSTEPS;
+    if (!gutter && ball.y >= -352 && fabs(ball.x) > 112)
+    {
+        gutter = ball.x < 0 ? -1 : 1;
+        ball.vx = 0;
+        ball.vy = 20;
+    }
+    if (gutter) ball.x += (gutter*132-ball.x)*0.20;
+    if (ball.y >= 570 || ball.y < -620 || fabs(ball.x) > 212 || shot_time > 130)
+    {
+        P_RemoveMobj(ball.actor);
+        ball.actor = NULL;
+    }
+}
+
+static void step_pins(void)
+{
+    int i,j;
+    for (i = 0; i < PIN_COUNT; ++i)
+    {
+        body_t *p = &pins[i];
+        if (!p->down || !p->actor) continue;
+        p->x += p->vx/SUBSTEPS;
+        p->y += p->vy/SUBSTEPS;
+        if (fabs(p->x) > 140)
+        {
+            p->x = p->x < 0 ? -140 : 140;
+            p->vx *= -0.48;
+        }
+        if (p->y > 564)
+        {
+            p->y = 564;
+            p->vy *= -0.43;
+        }
+        for (j = 0; j < PIN_COUNT; ++j)
+            if (i != j && pins[j].actor && (!pins[j].down || j > i))
+                collide(p,&pins[j],37,0);
+    }
+}
+
+static void finish_roll(void)
+{
+    int i, hits, remaining = 0, f = card.frame, b = card.count[f], mark;
+    for (i = 0; i < PIN_COUNT; ++i) remaining += !pins[i].down;
+    hits = card.standing-remaining;
+    record_roll(hits);
+    mark = Bowl_Mark(f,b);
+    if (mark == 'X') { strcpy(result,"STRIKE!"); S_StartSound(NULL,sfx_brstrk); }
+    else if (mark == '/') strcpy(result,"SPARE!");
+    else if (!hits && gutter) strcpy(result,"GUTTER");
+    else snprintf(result,sizeof(result),"%d DOWN",hits);
+    printf("BOWL: frame %d ball %d pinfall %d mark %c%s\n",f+1,b+1,hits,mark,
+           Bowl_GameOver() ? " GAME OVER" : "");
+    if (rack_pending) respot();
+    else if (!Bowl_GameOver())
+    {
+        // The pinsetter sweeps deadwood before a spare or fill-ball attempt.
+        for (i = 0; i < PIN_COUNT; ++i)
+            if (pins[i].down && pins[i].actor)
+            {
+                P_RemoveMobj(pins[i].actor);
+                pins[i].actor = NULL;
+            }
+    }
+    settling = 0;
+}
+
+void Bowl_Ticker(void)
+{
+    int i, step, moving = 0;
+    mobj_t *player;
+    if (!Bowl_Active()) return;
+    player = players[consoleplayer].mo;
+    // Approach stays open to lateral movement and the side exit switch.
+    if (player && player->y > -354*FRACUNIT)
+    {
+        P_TryMove(player,player->x,-354*FRACUNIT);
+        player->momy = 0;
+    }
+    if (!settling) return;
+    ++shot_time;
+    for (step = 0; step < SUBSTEPS; ++step)
+    {
+        if (ball.actor) travel_ball();
+        if (ball.actor && !gutter && ball.y > 340)
+            for (i = 0; i < PIN_COUNT; ++i)
+                if (pins[i].actor) collide(&ball,&pins[i],35,1);
+        step_pins();
+    }
+    if (ball.actor) move_actor(&ball);
+    for (i = 0; i < PIN_COUNT; ++i)
+    {
+        body_t *p = &pins[i];
+        if (!p->down || !p->actor) continue;
+        move_actor(p);
+        p->vx *= 0.92;
+        p->vy *= 0.92;
+        if (p->vx*p->vx + p->vy*p->vy > 0.20) moving = 1;
+        else p->vx = p->vy = 0;
+    }
+    if (!ball.actor && (!moving || shot_time >= 190)) finish_roll();
+}
+
+void Bowl_DrawHUD(void)
+{
+    int f, score = 0, i, standing = 0;
+    if (!Bowl_Active() || Bowl_GameOver()) return;
+    for (f=0; f<=TENTH; ++f)
+    {
+        int total = Bowl_FrameScore(f);
+        if (total < 0) break;
+        score = total;
+    }
+    for (i=0; i<PIN_COUNT; ++i) standing += !pins[i].down;
+    Bowl_DrawConsole(card.frame+1,card.count[card.frame]+1,score,standing,result);
+}
+
+int Bowl_BlockSave(void)
+{
+    if (!Bowl_Active()) return 0;
+    players[consoleplayer].message = "USE A VM CHECKPOINT FOR THIS GAME.";
+    return 1;
+}
+
+void Bowl_Init(void)
+{
+    int i;
+    enabled = M_CheckParm("-bowl") != 0;
+    if (!enabled) return;
+    if (!omega_mode) I_Error("-bowl requires -omega");
+    if (W_CheckNumForName("BALLA0") < 0 || W_CheckNumForName("BALLB0") < 0 ||
+        W_CheckNumForName("BALLC0") < 0 || W_CheckNumForName("DSBRROLL") < 0 ||
+        W_CheckNumForName("DSBRPINS") < 0 || W_CheckNumForName("DSBRSTRK") < 0)
+        I_Error("-bowl requires the Barrel Bowling arcade IWAD");
+    states[S_BOWL_PIN] = (state_t){SPR_MINI,0,-1,{NULL},S_BOWL_PIN,0,0};
+    states[S_BOWL_PIN_FALL] = (state_t){SPR_MINI,5,4,{NULL},S_BOWL_PIN_FALL+1,0,0};
+    states[S_BOWL_PIN_FALL+1] = (state_t){SPR_MINI,7,5,{NULL},S_BOWL_PIN_DOWN,0,0};
+    states[S_BOWL_PIN_DOWN] = (state_t){SPR_MINI,8,-1,{NULL},S_BOWL_PIN_DOWN,0,0};
+    for (i = 0; i < 3; ++i)
+        states[S_BOWL_BALL+i] = (state_t){SPR_BALL,i,3,{NULL},S_BOWL_BALL+(i+1)%3,0,0};
+    mobjinfo[MT_BOWL_PIN] = mobjinfo[MT_MISC0];
+    mobjinfo[MT_BOWL_PIN].doomednum = -1;
+    mobjinfo[MT_BOWL_PIN].spawnstate = S_BOWL_PIN;
+    mobjinfo[MT_BOWL_PIN].flags = MF_NOBLOCKMAP|MF_NOGRAVITY;
+    mobjinfo[MT_BOWL_PIN].height = 28*FRACUNIT;
+    mobjinfo[MT_BOWL_PIN].radius = 18*FRACUNIT;
+    mobjinfo[MT_BOWL_BALL] = mobjinfo[MT_BOWL_PIN];
+    mobjinfo[MT_BOWL_BALL].spawnstate = S_BOWL_BALL;
+}

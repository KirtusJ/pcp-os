+++ b/doomgeneric/fork_ui.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Compact load counter and dispatch map for Dock 07.
+#include <stdio.h>
+#include "fork.h"
+#include "fork_ui.h"
+#include "doomstat.h"
+#include "v_video.h"
+#include "w_wad.h"
+#include "z_zone.h"
+enum { INK=7, GREEN=114, WHITE=49, COPPER=144, SHADOW=5, EDGE=141, STEEL=104, RED=174, AMBER=248 };
+static const unsigned char letters[26][7] = {
+    {14,17,17,31,17,17,17},{30,17,17,30,17,17,30},
+    {14,17,16,16,16,17,14},{30,17,17,17,17,17,30},
+    {31,16,16,30,16,16,31},{31,16,16,30,16,16,16},
+    {14,17,16,23,17,17,14},{17,17,17,31,17,17,17},
+    {14,4,4,4,4,4,14},{7,2,2,2,2,18,12},
+    {17,18,20,24,20,18,17},{16,16,16,16,16,16,31},
+    {17,27,21,21,17,17,17},{17,25,25,21,19,19,17},
+    {14,17,17,17,17,17,14},{30,17,17,30,16,16,16},
+    {14,17,17,17,21,18,13},{30,17,17,30,20,18,17},
+    {15,16,16,14,1,1,30},{31,4,4,4,4,4,4},
+    {17,17,17,17,17,17,14},{17,17,17,17,17,10,4},
+    {17,17,17,17,21,27,17},{17,17,10,4,10,17,17},
+    {17,17,10,4,4,4,4},{31,1,2,4,8,16,31}
+};
+static const unsigned char digits[10][7] = {
+    {14,17,19,21,25,17,14},{4,12,4,4,4,4,14},
+    {14,17,1,2,4,8,31},{30,1,1,14,1,1,30},
+    {2,6,10,18,31,2,2},{31,16,16,30,1,1,30},
+    {14,16,16,30,17,17,14},{31,1,2,4,8,8,8},
+    {14,17,17,14,17,17,14},{14,17,17,15,1,1,14}
+};
+
+static void glyph(int x, int y, int c, int ink, int scale)
+{
+    static const unsigned char slash[7] = {1,1,2,4,8,16,16};
+    static const unsigned char dash[7] = {0,0,0,14,0,0,0};
+    static const unsigned char bang[7] = {4,4,4,4,4,0,4};
+    const unsigned char *rows;
+    int i, j;
+    if (c >= 'A' && c <= 'Z') rows = letters[c-'A'];
+    else if (c >= '0' && c <= '9') rows = digits[c-'0'];
+    else if (c == '/') rows = slash;
+    else if (c == '-') rows = dash;
+    else if (c == '!') rows = bang;
+    else return;
+    for (i=0; i<7; ++i)
+        for (j=0; j<5; ++j)
+            if (rows[i] & (16 >> j))
+                V_DrawFilledBox(x+j*scale,y+i*scale,scale,scale,ink);
+}
+
+static void text_at(int x, int y, const char *s, int ink, int scale)
+{
+    for (; *s; ++s, x+=6*scale) glyph(x,y,*s,ink,scale);
+}
+
+static int radar_x(double x) { return 276+(int)((x+608)*38/1216); }
+static int radar_y(double y) { return 6+(int)((544-y)*29/1056); }
+
+static void map_dot(double x,double y,int size,int color)
+{
+    int px=radar_x(x),py=radar_y(y);
+    if (px<276 || px>314 || py<6 || py>35) return;
+    V_DrawFilledBox(px-size/2,py-size/2,size,size,color);
+}
+
+static void bay_diagram(int phase)
+{
+    static const int sites[3][2]={{-352,160},{352,160},{0,-368}};
+    int i;
+    player_t *p=&players[displayplayer];
+    V_DrawFilledBox(273,3,44,35,EDGE);
+    V_DrawFilledBox(274,4,42,33,INK);
+    for (i=0;i<3;++i)
+        if (Fork_StackAlive(i)) map_dot(sites[i][0],sites[i][1],4,RED);
+    map_dot(Fork_BossX(),Fork_BossY(),3,phase==FORK_WARN ? WHITE : AMBER);
+    if (p->mo) map_dot(p->mo->x/65536.0,p->mo->y/65536.0,2,GREEN);
+}
+
+void Fork_Draw(void)
+{
+    int i,phase,broken,ink=WHITE,weapon;
+    const char *task;
+    char text[36];
+    player_t *p;
+    if (!Fork_Active()) return;
+    phase=Fork_Phase();
+    if (phase==FORK_CLEAR)
+    {
+        V_DrawPatch(0,0,W_CacheLumpName("FKPERMIT",PU_CACHE));
+        text_at(94,184,"FIRE TO PLAY AGAIN",AMBER,1);
+        return;
+    }
+    p=&players[displayplayer];
+    weapon=p->weaponowned[wp_missile];
+    broken=Fork_Broken();
+    task="BAIT HIM INTO RED CARGO";
+    if (phase==FORK_WARN) {task="AIM LOCKED / STEP ASIDE";ink=AMBER;}
+    else if (phase==FORK_CHARGE) {task="FORKS DOWN / MOVE!";ink=AMBER;}
+    else if (phase==FORK_STUN) task="STALLED / FIND NEXT STACK";
+    else if (phase==FORK_FOOT) task=weapon ? "DRIVER ON FOOT / FIRE!" : "GET YOUR ROCKET LAUNCHER";
+    V_DrawFilledBox(3,3,164,24,SHADOW);
+    V_DrawVertLine(3,3,24,phase==FORK_WARN ? RED : AMBER);
+    text_at(7,6,"DOCK 07",COPPER,1);
+    if (phase==FORK_FOOT)
+        snprintf(text,sizeof(text),"LUCKY %d HP",Fork_BossHealth()>0 ? Fork_BossHealth() : 0);
+    else snprintf(text,sizeof(text),"CARGO %d/3",broken);
+    text_at(71,6,text,WHITE,1);
+    text_at(7,17,task,ink,1);
+    if (phase!=FORK_FOOT)
+        for (i=0;i<3;++i)
+            V_DrawFilledBox(139+7*i,7,5,5,Fork_StackAlive(i) ? RED : STEEL);
+    bay_diagram(phase);
+}

--- /dev/null
+++ b/doomgeneric/fork.c
@@ -0,0 +1,385 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Forklift Certified: a telegraphed charge, three breakable shipments, one driver.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "fork.h"
+#include "omega.h"
+#include "doomstat.h"
+#include "p_local.h"
+#include "m_argv.h"
+#include "i_system.h"
+#include "sounds.h"
+#include "s_sound.h"
+#include "w_wad.h"
+#include "g_game.h"
+
+extern void A_Chase(mobj_t *);
+extern void A_Look(mobj_t *);
+extern void A_FaceTarget(mobj_t *);
+extern void A_Fall(mobj_t *);
+extern void A_Pain(mobj_t *);
+extern boolean P_CheckMeleeRange(mobj_t *);
+
+enum { STACKS = 3, CREW = 6, DRIVER_HP = 130 };
+static const int stack_sites[STACKS][2] = {{-352,160},{352,160},{0,-368}};
+static const int routes[][2] = {{-240,32},{192,-104},{232,296},{-208,288}};
+static int enabled;
+static struct {
+    mobj_t *lift, *driver, *stack[STACKS], *crew[CREW];
+    int broken, released, route, ticks, phase, replay_held;
+    int first_patrol, player_hit;
+    fixed_t dx,dy;
+} job;
+
+int Fork_Active(void) { return enabled && omega_mode && gameepisode == 1 && gamemap == 9 && gamemission == doom; }
+int Fork_Phase(void) { return job.phase; }
+int Fork_Broken(void) { return job.broken; }
+int Fork_Released(void) { return job.released; }
+int Fork_FootMaxHP(void) { return DRIVER_HP; }
+int Fork_BossHealth(void) { return job.driver ? (job.driver->health > 0 ? job.driver->health : 0) : 0; }
+int Fork_StackAlive(int i) { return i >= 0 && i < STACKS && job.stack[i] != NULL; }
+static mobj_t *boss(void) { return job.driver ? job.driver : job.lift; }
+int Fork_BossX(void) { return boss() ? boss()->x / FRACUNIT : 0; }
+int Fork_BossY(void) { return boss() ? boss()->y / FRACUNIT : 0; }
+int Fork_MinionsAlive(void)
+{
+    int i,n=0;
+    for (i=0;i<job.released;++i) if (job.crew[i]->health > 0) ++n;
+    return n;
+}
+
+int Fork_BlockSave(void)
+{
+    if (!Fork_Active()) return 0;
+    players[consoleplayer].message = "USE A VM CHECKPOINT FOR THIS SHIFT.";
+    return 1;
+}
+
+static void state(int id, int sprite, int frame, int ticks, void (*action)(mobj_t *), int next)
+{
+    states[id] = (state_t){sprite,frame,ticks,{NULL},next,0,0};
+    states[id].action.acp1 = (actionf_p1)action;
+}
+
+static void bite(mobj_t *m)
+{
+    if (m->target && P_CheckMeleeRange(m))
+    {
+        A_FaceTarget(m);
+        P_DamageMobj(m->target,m,m,3);
+    }
+}
+
+static void fire(mobj_t *m)
+{
+    if (!m->target || m->target->health <= 0 || !P_CheckSight(m,m->target)) return;
+    A_FaceTarget(m);
+    P_SpawnMissile(m,m->target,MT_TROOPSHOT);
+}
+
+void Fork_Init(void)
+{
+    int i;
+    char name[9] = "LUCKA0";
+    enabled = M_CheckParm("-forklift") != 0;
+    if (!enabled) return;
+    if (!omega_mode) I_Error("-forklift requires -omega");
+    for (i=0;i<7;++i)
+    {
+        name[4] = 'A'+i;
+        if (W_CheckNumForName(name) < 0) I_Error("-forklift: missing %s in the dock IWAD",name);
+    }
+    if (W_CheckNumForName("FORKA1") < 0 || W_CheckNumForName("FORKH0") < 0 ||
+        W_CheckNumForName("CARGD0") < 0 || W_CheckNumForName("DSFRBEEP") < 0 ||
+        W_CheckNumForName("DSFRHYD") < 0 || W_CheckNumForName("DSFRSMAS") < 0 ||
+        W_CheckNumForName("DSFRCLEA") < 0)
+        I_Error("-forklift requires the Forklift Certified dock IWAD");
+
+    for (i=0;i<8;++i)
+        state(S_FORK_DRIVE+i,SPR_FORK,i,-1,NULL,S_FORK_DRIVE+i);
+    state(S_FORK_DRIVE,SPR_FORK,0,6,NULL,S_FORK_DRIVE2);
+    state(S_FORK_DRIVE2,SPR_FORK,1,6,NULL,S_FORK_DRIVE);
+    state(S_FORK_WARN,SPR_FORK,2|FF_FULLBRIGHT,-1,NULL,S_FORK_WARN);
+    state(S_FORK_CHARGE,SPR_FORK,3|FF_FULLBRIGHT,-1,NULL,S_FORK_CHARGE);
+    state(S_FORK_WRECK,SPR_FORK,5,8,NULL,S_FORK_WRECK2);
+    state(S_FORK_WRECK2,SPR_FORK,6,8,NULL,S_FORK_PARKED);
+
+    state(S_FORK_CARGO,SPR_CARG,0,-1,NULL,S_FORK_CARGO);
+    state(S_FORK_CRACK,SPR_CARG,1,5,NULL,S_FORK_BURST);
+    state(S_FORK_BURST,SPR_CARG,2,6,NULL,S_FORK_SPLINTERS);
+    state(S_FORK_SPLINTERS,SPR_CARG,3,-1,NULL,S_FORK_SPLINTERS);
+
+    state(S_FORK_DRIVER_IDLE,SPR_LUCK,0,8,A_Look,S_FORK_DRIVER_IDLE);
+    state(S_FORK_FOOT,SPR_LUCK,0,5,A_Chase,S_FORK_FOOT2);
+    state(S_FORK_FOOT2,SPR_LUCK,1,5,A_Chase,S_FORK_FOOT);
+    state(S_FORK_AIM,SPR_LUCK,2,12,A_FaceTarget,S_FORK_FIRE);
+    state(S_FORK_FIRE,SPR_LUCK,2|FF_FULLBRIGHT,17,fire,S_FORK_FOOT);
+    state(S_FORK_PAIN,SPR_LUCK,3,4,A_Pain,S_FORK_FOOT);
+    for (i=0;i<4;++i)
+        state(S_FORK_DIE+i,SPR_LUCK,3+i,i==3 ? -1 : 6,i==0 ? A_Fall:NULL,
+              i==3 ? S_FORK_BODY : S_FORK_DIE+i+1);
+    state(S_FORK_BITE,SPR_MINI,2,8,A_FaceTarget,S_FORK_BITE2);
+    state(S_FORK_BITE2,SPR_MINI,3,12,bite,S_OMEGA_MINI+2);
+    state(S_FORK_OFFSHIFT,SPR_MINI,0,-1,NULL,S_FORK_OFFSHIFT);
+    mobjinfo[MT_FORK_LIFT] = mobjinfo[MT_BARREL];
+    mobjinfo[MT_FORK_LIFT].doomednum = -1;
+    mobjinfo[MT_FORK_LIFT].spawnstate = S_FORK_DRIVE;
+    mobjinfo[MT_FORK_LIFT].flags = MF_SOLID|MF_SHOOTABLE;
+    mobjinfo[MT_FORK_LIFT].radius = 26*FRACUNIT;
+    mobjinfo[MT_FORK_LIFT].height = 50*FRACUNIT;
+
+    mobjinfo[MT_FORK_CARGO] = mobjinfo[MT_FORK_LIFT];
+    mobjinfo[MT_FORK_CARGO].spawnstate = S_FORK_CARGO;
+    mobjinfo[MT_FORK_CARGO].radius = 20*FRACUNIT;
+    mobjinfo[MT_FORK_CARGO].height = 40*FRACUNIT;
+
+    mobjinfo[MT_FORK_DRIVER] = mobjinfo[MT_OMEGA_HUSK];
+    mobjinfo[MT_FORK_DRIVER].spawnhealth = DRIVER_HP;
+    mobjinfo[MT_FORK_DRIVER].speed = 6;
+    mobjinfo[MT_FORK_DRIVER].painchance = 72;
+    mobjinfo[MT_FORK_DRIVER].radius = 15*FRACUNIT;
+    mobjinfo[MT_FORK_DRIVER].height = 36*FRACUNIT;
+    mobjinfo[MT_FORK_DRIVER].spawnstate = S_FORK_DRIVER_IDLE;
+    mobjinfo[MT_FORK_DRIVER].seestate = S_FORK_FOOT;
+    mobjinfo[MT_FORK_DRIVER].painstate = S_FORK_PAIN;
+    mobjinfo[MT_FORK_DRIVER].missilestate = S_FORK_AIM;
+    mobjinfo[MT_FORK_DRIVER].meleestate = S_NULL;
+    mobjinfo[MT_FORK_DRIVER].deathstate = S_FORK_DIE;
+
+    mobjinfo[MT_FORK_MINI] = mobjinfo[MT_OMEGA_MINI];
+    mobjinfo[MT_FORK_MINI].spawnhealth = 12;
+    mobjinfo[MT_FORK_MINI].speed = 6;
+    mobjinfo[MT_FORK_MINI].missilestate = S_NULL;
+    mobjinfo[MT_FORK_MINI].meleestate = S_FORK_BITE;
+}
+
+void Fork_LevelStart(void)
+{
+    int i;
+    memset(&job,0,sizeof(job));
+    if (!Fork_Active()) return;
+    job.lift = P_SpawnMobj(0,288*FRACUNIT,ONFLOORZ,MT_FORK_LIFT);
+    job.lift->angle = ANG270;
+    for (i=0;i<STACKS;++i)
+        job.stack[i] = P_SpawnMobj(stack_sites[i][0]*FRACUNIT,stack_sites[i][1]*FRACUNIT,
+                                   ONFLOORZ,MT_FORK_CARGO);
+    job.first_patrol = 1;
+    job.ticks = 66;
+    printf("FORK: shift started, three cargo stacks ready\n");
+}
+
+static int overlap(mobj_t *other, fixed_t x, fixed_t y, fixed_t r)
+{
+    return other && abs(other->x-x) < r+other->radius && abs(other->y-y) < r+other->radius;
+}
+
+static mobj_t *from_crate(mobj_t *origin, mobjtype_t type, angle_t start, int dist)
+{
+    // The open dock has space around every stack. Pick a free, walkable
+    // landing point. Actors launch radially and Doom handles their landing.
+    int ring,i;
+    mobj_t probe = {0};
+    probe.radius = mobjinfo[type].radius;
+    probe.height = mobjinfo[type].height;
+    probe.flags = mobjinfo[type].flags & ~MF_PICKUP;
+    for (ring=0;ring<4;++ring)
+        for (i=0;i<8;++i)
+        {
+            unsigned a = (start + i*ANG45) >> ANGLETOFINESHIFT;
+            fixed_t x = origin->x + (dist+ring*16)*finecosine[a];
+            fixed_t y = origin->y + (dist+ring*16)*finesine[a];
+            if (x < -572*FRACUNIT || x > 572*FRACUNIT || y < -474*FRACUNIT || y > 506*FRACUNIT)
+                continue;
+            if (P_CheckPosition(&probe,x,y))
+            {
+                mobj_t *m = P_SpawnMobj(x,y,ONFLOORZ,type);
+                m->angle = start;
+                return m;
+            }
+        }
+    return P_SpawnMobj(origin->x,origin->y,ONFLOORZ,type);
+}
+
+static void dismount(mobj_t *p)
+{
+    mobj_t *weapon;
+    angle_t inward = R_PointToAngle2(job.lift->x,job.lift->y,0,0);
+    job.phase = FORK_FOOT;
+    job.lift->flags &= ~(MF_SOLID|MF_SHOOTABLE);
+    P_SetMobjState(job.lift,S_FORK_WRECK);
+    weapon = from_crate(job.lift,MT_MISC27,inward,100);
+    weapon->momz = 4*FRACUNIT;
+    from_crate(weapon,MT_MISC19,inward,25);
+    from_crate(weapon,MT_MISC19,inward+ANG90,28);
+    job.driver = from_crate(job.lift,MT_FORK_DRIVER,inward+ANG180,64);
+    job.driver->target = p;
+    job.driver->reactiontime = 13;
+    P_SetMobjState(job.driver,S_FORK_FOOT);
+    ++totalkills;
+    S_StartSound(job.lift,sfx_frhyd);
+    players[consoleplayer].message = "LAUNCHER DROPPED! LUCKY IS ON FOOT.";
+    printf("FORK: launcher dropped at %d,%d; driver on foot (%d hp)\n",
+           weapon->x/FRACUNIT,weapon->y/FRACUNIT,job.driver->health);
+}
+
+static void stun(void)
+{
+    job.phase = FORK_STUN;
+    job.ticks = 58;
+    P_SetMobjState(job.lift,S_FORK_STUN);
+    S_StartSound(job.lift,sfx_frsmas);
+}
+
+static void smash(int index,mobj_t *player)
+{
+    int i;
+    mobj_t *c = job.stack[index];
+    angle_t outward = R_PointToAngle2(job.lift->x,job.lift->y,c->x,c->y);
+    job.stack[index] = NULL;
+    ++job.broken;
+    c->flags &= ~(MF_SOLID|MF_SHOOTABLE);
+    P_SetMobjState(c,S_FORK_CRACK);
+    stun();
+    for (i=0;i<2;++i)
+    {
+        mobj_t *m = from_crate(c,MT_FORK_MINI,outward+(i ? ANG90 : ANG270),36);
+        unsigned a = R_PointToAngle2(c->x,c->y,m->x,m->y) >> ANGLETOFINESHIFT;
+        m->z += 12*FRACUNIT;
+        m->momz = 4*FRACUNIT;
+        m->momx = 2*finecosine[a];
+        m->momy = 2*finesine[a];
+        m->target = player;
+        m->reactiontime = 22;
+        P_SetMobjState(m,m->info->seestate);
+        job.crew[job.released++] = m;
+        ++totalkills;
+    }
+    printf("FORK: stack %d smashed; %d/3; two nested minis ejected (%d/6)\n",index+1,job.broken,job.released);
+    if (job.broken == STACKS) dismount(player);
+}
+
+static void acquire(mobj_t *player)
+{
+    unsigned a;
+    job.phase = FORK_WARN;
+    job.ticks = 39;
+    job.player_hit = 0;
+    job.lift->angle = R_PointToAngle2(job.lift->x,job.lift->y,player->x,player->y);
+    a = job.lift->angle >> ANGLETOFINESHIFT;
+    job.dx = 6*finecosine[a];
+    job.dy = 6*finesine[a];
+    P_SetMobjState(job.lift,S_FORK_WARN);
+    S_StartSound(job.lift,sfx_frbeep);
+    printf("FORK: horn from %d,%d; committed to %d,%d\n",Fork_BossX(),Fork_BossY(),
+           player->x/FRACUNIT,player->y/FRACUNIT);
+}
+
+static void patrol(mobj_t *player)
+{
+    mobj_t *m = job.lift;
+    angle_t toward;
+    unsigned a;
+    if (!job.first_patrol)
+    {
+        fixed_t x = routes[job.route][0]*FRACUNIT, y = routes[job.route][1]*FRACUNIT;
+        if (abs(m->x-x) < 32*FRACUNIT && abs(m->y-y) < 32*FRACUNIT)
+            job.route = (job.route+1)%arrlen(routes);
+        toward = R_PointToAngle2(m->x,m->y,x,y);
+        a = toward >> ANGLETOFINESHIFT;
+        if (!P_TryMove(m,m->x+3*finecosine[a],m->y+3*finesine[a]))
+            job.route = (job.route+1)%arrlen(routes);
+        m->angle = toward;
+    }
+    if (--job.ticks <= 0) acquire(player);
+}
+
+static void charge(mobj_t *p)
+{
+    mobj_t *m = job.lift;
+    int step,i;
+    for (step=0;step<3;++step)
+    {
+        fixed_t x = m->x+job.dx, y = m->y+job.dy;
+        for (i=0;i<STACKS;++i)
+            if (overlap(job.stack[i],x,y,m->radius)) { smash(i,p); return; }
+        for (i=0;i<job.released;++i)
+            if (job.crew[i]->health > 0 && overlap(job.crew[i],x,y,m->radius))
+                P_DamageMobj(job.crew[i],m,m,1000);
+        if (overlap(p,x,y,m->radius))
+        {
+            if (!job.player_hit) P_DamageMobj(p,m,m,12);
+            job.player_hit = 1;
+            // A player who stands their ground takes the impact and stalls
+            // the truck. Baiting from behind cargo protects the player.
+            stun();
+            return;
+        }
+        if (!P_TryMove(m,x,y)) { stun(); return; }
+    }
+    if (--job.ticks <= 0) stun();
+}
+
+static void complete(void)
+{
+    int i;
+    thinker_t *th;
+    job.phase = FORK_CLEAR;
+    job.ticks = 55;
+    job.replay_held = 1;
+    // Once the shift ends, stop the crew and any shots still in flight so
+    // the certification card can be read before replaying.
+    for (i=0;i<job.released;++i)
+        if (job.crew[i]->health > 0)
+        {
+            job.crew[i]->target = NULL;
+            P_SetMobjState(job.crew[i],S_FORK_OFFSHIFT);
+        }
+    for (th=thinkercap.next;th!=&thinkercap;th=th->next)
+        if (th->function.acp1 == (actionf_p1)P_MobjThinker && (((mobj_t *)th)->flags & MF_MISSILE))
+            P_RemoveMobj((mobj_t *)th);
+    S_StartSound(NULL,sfx_frclea);
+    printf("FORK: certification complete; 3 cargo stacks and driver defeated\n");
+}
+
+void Fork_Ticker(void)
+{
+    mobj_t *p;
+    if (!Fork_Active()) return;
+    p = players[consoleplayer].mo;
+    if (!p || p->health <= 0) return;
+    switch (job.phase)
+    {
+        case FORK_PATROL: patrol(p); break;
+        case FORK_WARN:
+            if (--job.ticks == 27 || job.ticks == 16) S_StartSound(job.lift,sfx_frbeep);
+            if (job.ticks <= 0)
+            {
+                job.phase = FORK_CHARGE;
+                job.ticks = 90;
+                P_SetMobjState(job.lift,S_FORK_CHARGE);
+            }
+            break;
+        case FORK_CHARGE: charge(p); break;
+        case FORK_STUN:
+            if (--job.ticks <= 0)
+            {
+                job.phase = FORK_PATROL;
+                job.first_patrol = 0;
+                job.ticks = 68;
+                P_SetMobjState(job.lift,S_FORK_DRIVE);
+            }
+            break;
+        case FORK_FOOT:
+            if (job.driver->health <= 0) complete();
+            break;
+        case FORK_CLEAR:
+        {
+            int held = players[consoleplayer].cmd.buttons & (BT_ATTACK|BT_USE);
+            if (job.ticks > 0) --job.ticks;
+            else if (held && !job.replay_held) G_DeferedInitNew(gameskill,1,9);
+            job.replay_held = held;
+            break;
+        }
+    }
+}

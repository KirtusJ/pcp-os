diff --git a/doomgeneric/rail_scroll.c b/doomgeneric/rail_scroll.c
new file mode 100644
index 0000000..df79029
--- /dev/null
+++ b/doomgeneric/rail_scroll.c
@@ -0,0 +1,52 @@
+/* The train stays in map coordinates. Only scenery tagged by its map moves. */
+#include "doomdef.h"
+#include "r_data.h"
+#include "rail_scroll.h"
+
+enum { LANDSCAPE_TAG = 771, SIGNAL_TAG = 772 };
+static int track_flat = -1;
+static int ballast_flat = -1;
+static int track_offset;
+
+void RailScroll_Update(int travel)
+{
+    int i, j;
+    if (track_flat < 0)
+    {
+        track_flat = R_FlatNumForName("RLTRACK");
+        ballast_flat = R_FlatNumForName("RLGRAVL");
+    }
+    track_offset = (travel & 63) * FRACUNIT;
+
+    for (i = 0; i < numlines; ++i)
+    {
+        line_t *line = &lines[i];
+        int distance;
+        if (line->tag == SIGNAL_TAG)
+            distance = travel;
+        else if (line->tag == LANDSCAPE_TAG)
+            distance = travel / 4;
+        else
+            continue;
+
+        for (j = 0; j < 2; ++j)
+        {
+            const vertex_t *start = j ? line->v2 : line->v1;
+            int direction, origin;
+            if (line->sidenum[j] < 0)
+                continue;
+            direction = line->dy > 0 ? 1 : -1;
+            if (j)
+                direction = -direction;
+            origin = start->y / FRACUNIT;
+            /* Mask before conversion to fixed_t, including long journeys. */
+            sides[line->sidenum[j]].textureoffset =
+                ((direction * (origin + (distance & 1023))) & 1023) * FRACUNIT;
+        }
+    }
+}
+
+int RailScroll_FlatOffset(int picnum)
+{
+    return picnum == track_flat || picnum == ballast_flat ? track_offset : 0;
+}

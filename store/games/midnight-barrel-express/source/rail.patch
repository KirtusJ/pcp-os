diff --git a/doomgeneric/rail.c b/doomgeneric/rail.c
new file mode 100644
index 0000000..e0614c2
--- /dev/null
+++ b/doomgeneric/rail.c
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Midnight Barrel Express. Speeds are meters/second; integrate at 35 Hz.
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rail.h"
+#include "rail_scroll.h"
+#include "doomstat.h"
+#include "p_local.h"
+#include "omega.h"
+#include "m_argv.h"
+#include "i_system.h"
+#include "w_wad.h"
+#include "s_sound.h"
+#include "sounds.h"
+#include "g_game.h"
+
+extern void A_Look(mobj_t *);
+extern void A_Chase(mobj_t *);
+extern void A_FaceTarget(mobj_t *);
+extern void A_Pain(mobj_t *);
+extern void A_Fall(mobj_t *);
+extern void A_PosAttack(mobj_t *);
+
+enum { START_METERS = 220, ZONE = 13, INITIAL_SPEED = 20, UNITS_PER_METER = 20 };
+static const double deceleration = 1.20;
+static const int panels[2][2]={{-84,-272},{84,160}};
+static int enabled;
+static struct {
+    int phase, locks[2], attempts, braking, use_held, require_release, chuff, hiss, end_ticks;
+    double speed, distance, travel;
+    mobj_t *handle, *conductor;
+} line;
+
+int Rail_Active(void) { return enabled && omega_mode && gameepisode == 1 && gamemap == 9 && gamemission == doom; }
+int Rail_Phase(void) { return line.phase; }
+int Rail_TicketReady(void) { return line.phase==RAIL_PARKED && line.end_ticks==0; }
+int Rail_Interlock(int i) { return i>=0 && i<2 && line.locks[i]; }
+int Rail_Speed(void) { return (int)ceil(line.speed*3.6-0.00001); }
+int Rail_Distance(void)
+{
+    // A stop just outside the zone must display outside it on the verdict.
+    if (line.phase==RAIL_OVER) return (int)floor(line.distance);
+    if (line.phase==RAIL_SHORT) return (int)ceil(line.distance);
+    return line.distance>=0 ? (int)(line.distance+0.5):(int)(line.distance-0.5);
+}
+int Rail_Zone(void) { return ZONE; }
+int Rail_StopDistance(void) { return (int)(line.speed*line.speed/(2*deceleration)+0.5); }
+int Rail_Braking(void) { return line.braking; }
+int Rail_Travel(void) { return (int)line.travel; }
+int Rail_Attempts(void) { return line.attempts; }
+int Rail_CabX(void) { return 0; }
+int Rail_CabY(void) { return 726; }
+int Rail_LeverX(int i) { return i>=0 && i<2 ? panels[i][0] : 0; }
+int Rail_LeverY(int i) { return i>=0 && i<2 ? panels[i][1] : 0; }
+
+int Rail_BlockSave(void)
+{
+    if (!Rail_Active()) return 0;
+    players[consoleplayer].message = "USE A VM CHECKPOINT FOR THIS TRAIN.";
+    return 1;
+}
+
+static void state(int id, int sprite, int frame, int ticks, void (*act)(mobj_t *), int next)
+{
+    states[id] = (state_t){sprite,frame,ticks,{NULL},next,0,0};
+    states[id].action.acp1 = (actionf_p1)act;
+}
+
+static void assets(const char *sprite,int count)
+{
+    char name[9];
+    int i;
+    for (i=0;i<count;++i)
+    {
+        snprintf(name,sizeof(name),"%s%c0",sprite,'A'+i);
+        if (W_CheckNumForName(name)<0) I_Error("-express: missing %s from rail IWAD",name);
+    }
+}
+
+void Rail_Init(void)
+{
+    static char sounds[][9] = {"DSRWHIST","DSRLOCK","DSRBRAKE","DSRBELL","DSRWHEEL"};
+    int i;
+    enabled = M_CheckParm("-express") != 0;
+    if (!enabled) return;
+    if (!omega_mode) I_Error("-express requires -omega");
+    assets("COND",8);
+    assets("BRAK",3);
+    assets("BRKM",6);
+    for (i=0;i<(int)arrlen(sounds);++i)
+        if (W_CheckNumForName(sounds[i])<0) I_Error("-express: missing %s from rail IWAD",sounds[i]);
+
+    for (i=0;i<8;++i)
+        state(S_RAIL_COND+i,SPR_COND,i,-1,NULL,S_RAIL_COND+i);
+    state(S_RAIL_COND,SPR_COND,0,22,NULL,S_RAIL_COND+1);
+    state(S_RAIL_COND+1,SPR_COND,1,14,NULL,S_RAIL_COND+2);
+    state(S_RAIL_COND+2,SPR_COND,2,14,NULL,S_RAIL_COND);
+    state(S_RAIL_COND+3,SPR_COND,3,24,NULL,S_RAIL_COND);
+    state(S_RAIL_COND+4,SPR_COND,4,8,NULL,S_RAIL_COND+5);
+    state(S_RAIL_COND+5,SPR_COND,5,12,NULL,S_RAIL_COND+6);
+    for (i=0;i<3;++i)
+        state(S_RAIL_BRAKE+i,SPR_BRAK,i,-1,NULL,S_RAIL_BRAKE+i);
+    state(S_RAIL_CREW,SPR_BRKM,0,10,A_Look,S_RAIL_CREW);
+    state(S_RAIL_CREW+1,SPR_BRKM,0,5,A_Chase,S_RAIL_CREW+2);
+    state(S_RAIL_CREW+2,SPR_BRKM,1,5,A_Chase,S_RAIL_CREW+1);
+    state(S_RAIL_CREW+3,SPR_BRKM,2,12,A_FaceTarget,S_RAIL_CREW+4);
+    state(S_RAIL_CREW+4,SPR_BRKM,2|FF_FULLBRIGHT,16,A_PosAttack,S_RAIL_CREW+1);
+    state(S_RAIL_CREW+5,SPR_BRKM,3,4,A_Pain,S_RAIL_CREW+1);
+    state(S_RAIL_CREW+6,SPR_BRKM,4,6,A_Fall,S_RAIL_CREW+7);
+    state(S_RAIL_CREW+7,SPR_BRKM,5,-1,NULL,S_RAIL_CREW+7);
+    state(S_RAIL_IDLE_CREW,SPR_BRKM,0,-1,NULL,S_RAIL_IDLE_CREW);
+
+    mobjinfo[MT_RAIL_COND] = mobjinfo[MT_MISC0];
+    mobjinfo[MT_RAIL_COND].doomednum=-1;
+    mobjinfo[MT_RAIL_COND].spawnstate=S_RAIL_COND;
+    mobjinfo[MT_RAIL_COND].flags=MF_NOBLOCKMAP;
+    mobjinfo[MT_RAIL_COND].height=43*FRACUNIT;
+    mobjinfo[MT_RAIL_HANDLE] = mobjinfo[MT_RAIL_COND];
+    mobjinfo[MT_RAIL_HANDLE].spawnstate=S_RAIL_BRAKE;
+    mobjinfo[MT_RAIL_CREW] = mobjinfo[MT_OMEGA_MINI];
+    mobjinfo[MT_RAIL_CREW].spawnhealth=18;
+    mobjinfo[MT_RAIL_CREW].speed=6;
+    mobjinfo[MT_RAIL_CREW].spawnstate=S_RAIL_CREW;
+    mobjinfo[MT_RAIL_CREW].seestate=S_RAIL_CREW+1;
+    mobjinfo[MT_RAIL_CREW].painstate=S_RAIL_CREW+5;
+    mobjinfo[MT_RAIL_CREW].missilestate=S_RAIL_CREW+3;
+    mobjinfo[MT_RAIL_CREW].deathstate=S_RAIL_CREW+6;
+    mobjinfo[MT_RAIL_GUNNER]=mobjinfo[MT_RAIL_CREW];
+}
+
+void Rail_LevelStart(void)
+{
+    memset(&line,0,sizeof(line));
+    if (!Rail_Active()) return;
+    line.speed=INITIAL_SPEED;
+    line.distance=START_METERS;
+    line.handle=P_SpawnMobj(Rail_CabX()*FRACUNIT,Rail_CabY()*FRACUNIT,ONFLOORZ,MT_RAIL_HANDLE);
+    line.conductor=P_SpawnMobj(40*FRACUNIT,744*FRACUNIT,ONFLOORZ,MT_RAIL_COND);
+    RailScroll_Update(0);
+    S_StartSound(NULL,sfx_rwhist);
+    printf("RAIL: departure, 72 km/h; two open interlocks\n");
+}
+
+void Rail_CabControls(player_t *p)
+{
+    if (!Rail_Active() || line.phase<RAIL_BRAKE) return;
+    // The brake is a fixed workstation; let the operator look around.
+    p->cmd.forwardmove=p->cmd.sidemove=0;
+    p->mo->momx=p->mo->momy=0;
+    p->cmd.buttons &= ~BT_ATTACK;
+    p->psprites[ps_weapon].state=p->psprites[ps_flash].state=NULL;
+}
+
+static int reachable(mobj_t *p,int x,int y)
+{
+    fixed_t dx=x*FRACUNIT-p->x,dy=y*FRACUNIT-p->y;
+    double u=(double)dx/FRACUNIT,v=(double)dy/FRACUNIT;
+    unsigned a=p->angle >> ANGLETOFINESHIFT;
+    // Inside arm's length a lever remains usable even if the operator turns.
+    return u*u+v*v<=68*68 && (u*u+v*v<=24*24 || u*finecosine[a]+v*finesine[a]>=0);
+}
+
+static void pull(mobj_t *p)
+{
+    int i;
+    for (i=0;i<2;++i)
+        if (reachable(p,panels[i][0],panels[i][1]))
+        {
+            if (line.locks[i]) return;
+            line.locks[i]=1;
+            S_StartSound(NULL,sfx_rlock);
+            players[consoleplayer].message=i==0 ? "CARGO INTERLOCK ENGAGED." : "TENDER INTERLOCK ENGAGED.";
+            if (line.locks[0] && line.locks[1])
+            {
+                line.phase=RAIL_ARMED;
+                P_SetMobjState(line.conductor,S_RAIL_COND+3);
+            }
+            printf("RAIL: interlock %d latched\n",i+1);
+            return;
+        }
+}
+
+static void take_brake(void)
+{
+    thinker_t *th;
+    line.phase=RAIL_BRAKE;
+    line.speed=INITIAL_SPEED;
+    line.distance=START_METERS;
+    line.braking=0;
+    line.require_release=1;
+    line.hiss=0;
+    ++line.attempts;
+    // Lucky sold tickets with a free cab ride. Nobody told him that meant work.
+    P_SetMobjState(line.conductor,S_RAIL_COND+4);
+    P_SetMobjState(line.handle,S_RAIL_BRAKE);
+    for (th=thinkercap.next;th!=&thinkercap;th=th->next)
+        if (th->function.acp1==(actionf_p1)P_MobjThinker)
+        {
+            mobj_t *m=(mobj_t *)th;
+            if ((m->type==MT_RAIL_CREW || m->type==MT_RAIL_GUNNER) && m->health>0)
+            {
+                m->target=NULL;
+                P_SetMobjState(m,S_RAIL_IDLE_CREW);
+            }
+        }
+    S_StartSound(NULL,sfx_rwhist);
+    printf("RAIL: handle taken, approach %d; 220 m to signal\n",line.attempts);
+}
+
+static void stop(int outcome)
+{
+    line.phase=outcome;
+    line.speed=0;
+    line.braking=0;
+    P_SetMobjState(line.handle,S_RAIL_BRAKE+2);
+    if (outcome==RAIL_PARKED)
+    {
+        P_SetMobjState(line.conductor,S_RAIL_COND+7);
+        S_StartSound(NULL,sfx_rbell);
+        line.end_ticks=(23*TICRATE+5)/10; // Let Lucky wave for 2.3 seconds.
+    }
+    else
+    {
+        P_SetMobjState(line.conductor,S_RAIL_COND+6);
+        S_StartSound(NULL,sfx_rbrake);
+    }
+    printf("RAIL: %s, signal %+d m, attempt %d\n",outcome==RAIL_PARKED ? "safe stop" :
+           outcome==RAIL_SHORT ? "stopped short":"overshot",Rail_Distance(),line.attempts);
+}
+
+static void advance(double meters)
+{
+    int beat;
+    line.travel+=meters*UNITS_PER_METER;
+    beat=Rail_Travel()/264;
+    if (beat!=line.chuff)
+    {
+        line.chuff=beat;
+        S_StartSound(NULL,sfx_rwheel);
+    }
+    RailScroll_Update(Rail_Travel());
+}
+
+static void approach(int use)
+{
+    double previous=line.speed,dt=1.0/TICRATE,meters;
+    if (!use) line.require_release=0;
+    if (line.hiss>0) --line.hiss;
+    if (use && !line.require_release)
+    {
+        if (!line.braking)
+        {
+            P_SetMobjState(line.handle,S_RAIL_BRAKE+1);
+            if (!line.hiss)
+            {
+                S_StartSound(line.handle,sfx_rbrake);
+                line.hiss=22;
+            }
+        }
+        line.braking=1;
+        line.speed=fmax(0,previous-deceleration*dt);
+        if (line.speed==0) dt=previous/deceleration;
+    }
+    else
+    {
+        if (line.braking) P_SetMobjState(line.handle,S_RAIL_BRAKE);
+        line.braking=0;
+    }
+    // Lucky wanted one average speed painted on the gauge. Nice try, conductor.
+    meters=(previous+line.speed)*0.5*dt;
+    line.distance-=meters;
+    advance(meters);
+    if (line.distance < -ZONE) stop(RAIL_OVER);
+    else if (line.speed==0) stop(line.distance>ZONE ? RAIL_SHORT:RAIL_PARKED);
+}
+
+void Rail_Ticker(void)
+{
+    int use,edge;
+    player_t *p;
+    if (!Rail_Active()) return;
+    p=&players[consoleplayer];
+    use=(p->cmd.buttons&BT_USE)!=0;
+    edge=use && !line.use_held;
+    line.use_held=use;
+    if (line.phase<=RAIL_ARMED)
+    {
+        advance(INITIAL_SPEED/(double)TICRATE);
+        if (!edge || !p->mo || p->health<=0) return;
+        if (reachable(p->mo,Rail_CabX(),Rail_CabY()))
+        {
+            if (line.phase==RAIL_ARMED) take_brake();
+            else p->message="TWO INTERLOCKS REQUIRED BEFORE BRAKING.";
+        }
+        else pull(p->mo);
+    }
+    else if (line.phase==RAIL_BRAKE) approach(use);
+    else if (edge && line.phase!=RAIL_PARKED) take_brake();
+    else if (line.phase==RAIL_PARKED)
+    {
+        if (line.end_ticks>0) --line.end_ticks;
+        else if (edge) G_DeferedInitNew(gameskill,1,9);
+    }
+}

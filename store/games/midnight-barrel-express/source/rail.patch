diff --git a/doomgeneric/rail_ui.c b/doomgeneric/rail_ui.c
new file mode 100644
index 0000000..fa45799
--- /dev/null
+++ b/doomgeneric/rail_ui.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Local railway instruments. The odometer is driven by the train simulation.
+#include <math.h>
+#include <stdio.h>
+#include "rail.h"
+#include "rail_ui.h"
+#include "doomstat.h"
+#include "p_local.h"
+#include "v_video.h"
+#include "w_wad.h"
+#include "z_zone.h"
+
+enum { INK=7, DARK=5, MUTED=144, AMBER=248, CREAM=49, GREEN=114, RED=174, EDGE=141 };
+static const unsigned char letters[26][7] = {
+    {14,17,17,31,17,17,17},{30,17,17,30,17,17,30},
+    {14,17,16,16,16,17,14},{30,17,17,17,17,17,30},
+    {31,16,16,30,16,16,31},{31,16,16,30,16,16,16},
+    {14,17,16,23,17,17,14},{17,17,17,31,17,17,17},
+    {14,4,4,4,4,4,14},{7,2,2,2,2,18,12},
+    {17,18,20,24,20,18,17},{16,16,16,16,16,16,31},
+    {17,27,21,21,17,17,17},{17,25,25,21,19,19,17},
+    {14,17,17,17,17,17,14},{30,17,17,30,16,16,16},
+    {14,17,17,17,21,18,13},{30,17,17,30,20,18,17},
+    {15,16,16,14,1,1,30},{31,4,4,4,4,4,4},
+    {17,17,17,17,17,17,14},{17,17,17,17,17,10,4},
+    {17,17,17,17,21,27,17},{17,17,10,4,10,17,17},
+    {17,17,10,4,4,4,4},{31,1,2,4,8,16,31}
+};
+static const unsigned char digits[10][7] = {
+    {14,17,19,21,25,17,14},{4,12,4,4,4,4,14},
+    {14,17,1,2,4,8,31},{30,1,1,14,1,1,30},
+    {2,6,10,18,31,2,2},{31,16,16,30,1,1,30},
+    {14,16,16,30,17,17,14},{31,1,2,4,8,8,8},
+    {14,17,17,14,17,17,14},{14,17,17,15,1,1,14}
+};
+
+static void glyph(int x, int y, int c, int ink, int scale)
+{
+    static const unsigned char slash[7] = {1,1,2,4,8,16,16};
+    static const unsigned char dash[7] = {0,0,0,14,0,0,0};
+    static const unsigned char bang[7] = {4,4,4,4,4,0,4};
+    const unsigned char *rows;
+    int i, j;
+    if (c >= 'A' && c <= 'Z') rows = letters[c-'A'];
+    else if (c >= '0' && c <= '9') rows = digits[c-'0'];
+    else if (c == '/') rows = slash;
+    else if (c == '-') rows = dash;
+    else if (c == '!') rows = bang;
+    else return;
+    for (i=0; i<7; ++i)
+        for (j=0; j<5; ++j)
+            if (rows[i] & (16 >> j))
+                V_DrawFilledBox(x+j*scale,y+i*scale,scale,scale,ink);
+}
+
+static void text_at(int x, int y, const char *s, int ink, int scale)
+{
+    for (; *s; ++s, x+=6*scale) glyph(x,y,*s,ink,scale);
+}
+
+static void needle(int x, int y, int length, int speed)
+{
+    // A dial marked to 90 leaves a little headroom for the idiot in the hat.
+    double a=(145.0+(speed>90?90:speed)*(250.0/90.0))*0.01745329251994;
+    int j;
+    for (j=0;j<=length;++j)
+        V_DrawFilledBox(x+(int)round(j*cos(a)),y+(int)round(j*sin(a)),2,2,AMBER);
+    V_DrawFilledBox(x-1,y-1,4,4,CREAM);
+}
+
+static void stamp(void)
+{
+    char number[30];
+    int distance=Rail_Distance();
+    V_DrawPatch(0,0,W_CacheLumpName("RLTICKET",PU_CACHE));
+    if (distance==0) snprintf(number,sizeof(number),"ON MARK");
+    else snprintf(number,sizeof(number),"%d M %s",distance>0?distance:-distance,
+                  distance>0?"SHORT":"PAST");
+    text_at(24,155,number,INK,2);
+    snprintf(number,sizeof(number),"%d",Rail_Attempts());
+    text_at(175,155,number,INK,2);
+    text_at(182,183,"SPACE TO RIDE AGAIN",CREAM,1);
+}
+
+static void gauges(int phase)
+{
+    int dist=Rail_Distance(), predicted=Rail_StopDistance(), speed=Rail_Speed();
+    char data[30];
+    const char *t = phase==RAIL_PARKED ? "PARKED" : Rail_Braking() ? "APPLIED" : "COAST";
+    V_DrawPatch(0,147,W_CacheLumpName("RLPANEL",PU_CACHE));
+    needle(49,180,17,speed);
+    snprintf(data,sizeof(data),"%02d",speed);
+    text_at(78,177,data,CREAM,1);
+    snprintf(data,sizeof(data),"%d M",dist);
+    text_at(110,168,data,CREAM,2);
+    text_at(230,170,t,Rail_Braking()?AMBER:GREEN,1);
+    // When the distance to the signal matches the stopping distance,
+    // the two values describe the same point along the track.
+    snprintf(data,sizeof(data),"NEED %d M",predicted);
+    text_at(230,182,data,MUTED,1);
+    if (phase==RAIL_PARKED)
+    {
+        V_DrawFilledBox(4,3,160,18,INK);
+        V_DrawVertLine(4,3,18,GREEN);
+        text_at(10,9,"DEIMOS JUNCTION / ARRIVED",CREAM,1);
+        return;
+    }
+    V_DrawFilledBox(4,3,234,18,INK);
+    V_DrawVertLine(4,3,18,AMBER);
+    if (phase==RAIL_SHORT || phase==RAIL_OVER)
+    {
+        text_at(10,9,phase==RAIL_SHORT ? "STOPPED SHORT / SPACE TO RETRY" :
+                                      "PASSED SIGNAL / SPACE TO RETRY",AMBER,1);
+    }
+    else text_at(10,9,"HOLD SPACE TO BRAKE / RELEASE TO COAST",CREAM,1);
+}
+
+void Rail_Draw(void)
+{
+    int phase, first, second;
+    const char *label;
+    if (!Rail_Active()) return;
+    phase=Rail_Phase();
+    if (Rail_TicketReady()) { stamp(); return; }
+    if (phase>=RAIL_BRAKE)
+    {
+        gauges(phase);
+        return;
+    }
+    first=Rail_Interlock(0); second=Rail_Interlock(1);
+    // Lucky spent a whole paycheck on engraved signage. I still don't trust him.
+    if (leveltime<58 && !(players[displayplayer].cmd.forwardmove ||
+            players[displayplayer].cmd.sidemove || players[displayplayer].cmd.buttons))
+    {
+        V_DrawPatch(0,0,W_CacheLumpName("RLTITLE",PU_CACHE));
+        return;
+    }
+    label=first && second ? "CAB / TAKE BRAKE HANDLE" :
+          !first ? "CARGO CAR / PORT SWITCH" : "TENDER / STARBOARD SWITCH";
+    V_DrawFilledBox(3,3,180,24,DARK);
+    V_DrawVertLine(3,3,24,AMBER);
+    text_at(8,6,"EXPRESS 07",MUTED,1);
+    text_at(8,17,label,CREAM,1);
+    text_at(98,6,"LOCKS",MUTED,1);
+    V_DrawFilledBox(135,6,7,7,first?GREEN:EDGE);
+    V_DrawFilledBox(146,6,7,7,second?GREEN:EDGE);
+}

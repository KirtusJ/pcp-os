[
  "qemu-system-x86_64",
  "-L",
  "QEMU_FIRMWARE_DIRECTORY",
  "-machine",
  "q35,memory-backend=ram",
  "-object",
  "memory-backend-file,id=ram,size=96M,mem-path=BOOT_DIRECTORY/guest.ram,share=on",
  "-accel",
  "tcg,tb-size=8",
  "-cpu",
  "max",
  "-uuid",
  "c5e36e88-ee4d-4461-93f1-c7615ff3d78c",
  "-m",
  "96M",
  "-nic",
  "none",
  "-display",
  "none",
  "-vga",
  "none",
  "-device",
  "VGA,vgamem_mb=8,edid=on,xres=1280,yres=720",
  "-monitor",
  "none",
  "-qmp",
  "stdio",
  "-serial",
  "file:guest.serial",
  "-no-reboot",
  "-device",
  "isa-debug-exit,iobase=0xf4,iosize=0x04",
  "-drive",
  "if=pflash,format=raw,readonly=on,file=OVMF_CODE_4M.fd",
  "-drive",
  "if=pflash,format=raw,file=vars.fd",
  "-drive",
  "if=none,format=raw,id=os,file=WORKING.raw,cache=writeback",
  "-device",
  "virtio-blk-pci,drive=os,disable-modern=on,bootindex=1"
]
